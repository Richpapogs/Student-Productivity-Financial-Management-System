<Window x:Class="SP_FMS.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password" Height="480" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" ResizeMode="NoResize">

    <Grid>
        <Border Padding="30" Background="#1C2433" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center" Height="359">
            <StackPanel>
                <TextBlock Text="Password Recovery" Foreground="White"
                           FontWeight="Bold" FontSize="20" TextAlignment="Center" Margin="0,0,0,10"/>
                
                <TextBlock Text="Enter your Student ID and Email to receive a temporary password."
                           Foreground="#B0B0B0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Student ID -->
                <TextBlock Text="Student ID:" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="txtStudentId" Height="35" Width="400" Margin="0,0,0,15" FontSize="13" Padding="8"/>

                <!-- Email -->
                <TextBlock Text="Email:" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Width="400" Margin="0,0,0,25" FontSize="13" Padding="8"/>

                <!-- Error Message -->
                <TextBlock x:Name="lblErrorMessage" 
                           Foreground="Red" 
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Cancel" Width="120" Height="35" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Generate Temporary Password" Width="200" Height="35" Click="GeneratePassword_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Success Message Popup (Centered Overlay) -->
        <Border x:Name="borderSuccess" 
                Background="#1E3A1E" 
                BorderBrush="#4CAF50" 
                BorderThickness="2"
                CornerRadius="8"
                Padding="25"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="350">
            <StackPanel>
                <TextBlock Text="Temporary Password Generated!" 
                           Foreground="#4CAF50" 
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblTempPassword" 
                           Foreground="White" 
                           FontSize="24"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Please use this password to login and change it in your Dashboard > Profile."
                           Foreground="#B0B0B0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>
                <Button Content="Login" 
                        Width="120" 
                        Height="35" 
                        Click="Login_Click"
                        HorizontalAlignment="Center"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="10,5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45a049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

