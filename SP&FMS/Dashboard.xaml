<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="SP_FMS.Dashboard" WindowStartupLocation="CenterScreen" Width="1000" Title="Student Dashboard" Height="600" Background="#0E1726"
>
    <Grid Margin="20"
>
        <StackPanel
>
            <!-- Back Button -->
            <Button Width="80" Margin="0,0,0,10" Height="30" HorizontalAlignment="Left" FontWeight="Bold" Foreground="White" Content="Log Out" Click="BackButton_Click" BorderBrush="White" Background="#1E2A38"/>
            <!-- Header -->
            <TextBlock Text="Student Dashboard" Margin="10,10,0,20" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TabControl Width="965" Padding="10" Height="430" FontSize="14" Foreground="White" BorderThickness="0" Background="#0E1726"
>
                <!-- Profile Tab -->
                <TabItem Header="Profile" Margin="32,1,-174,-3"
>
                    <Grid Margin="10"
>
                        <Grid.ColumnDefinitions
>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Personal Info -->
                        <Border Padding="20" Margin="0,0,10,10" CornerRadius="10" Background="White"
>
                            <StackPanel
>
                                <TextBlock Text="Personal Information"
           Margin="0,0,0,15"
           FontSize="18"
           FontWeight="Bold"
           Foreground="Black"
           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="lblWelcome"
           Margin="0,0,0,20"
           FontSize="18"
           FontWeight="Bold"
           Foreground="Black"
           TextAlignment="Left"/>

                                <TextBlock x:Name="lblDetails"
           Margin="0,0,0,20"
           FontSize="16"
           Foreground="Black"
           TextAlignment="Left"
           TextWrapping="Wrap"
           LineHeight="13"/>

                                <!-- Change Password Link -->
                                <TextBlock x:Name="txtChangePassword" 
                                           Text="Change Password" 
                                           FontSize="14" 
                                           Foreground="Black"
                                           Cursor="Hand"
                                           HorizontalAlignment="Center"
                                           MouseLeftButtonDown="ChangePassword_Click"
                                           MouseEnter="ChangePassword_MouseEnter"
                                           MouseLeave="ChangePassword_MouseLeave"
                                           Margin="70"/>
                                           

                            </StackPanel>
                        </Border>
                        
                        <!-- Pie Chart -->
                        <Border Padding="20" Margin="10,0,10,10" Grid.Column="1" CornerRadius="10" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Task Progress (7 Days)" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="Black" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,10"/>
                                
                                <!-- Pie Chart Container -->
                                <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="200" Height="200">
                                        <!-- Completed Tasks (Green) -->
                                        <Path x:Name="pathCompleted" 
                                              Fill="#4CAF50" 
                                              Stroke="White" 
                                              StrokeThickness="2">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure x:Name="figureCompleted" StartPoint="100,100">
                                                        <LineSegment Point="100,0"/>
                                                        <ArcSegment x:Name="arcCompleted" 
                                                                    Size="100,100" 
                                                                    SweepDirection="Clockwise" 
                                                                    Point="100,100" 
                                                                    IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        
                                        <!-- Uncompleted Tasks (Red) -->
                                        <Path x:Name="pathUncompleted" 
                                              Fill="#F44336" 
                                              Stroke="White" 
                                              StrokeThickness="2">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure x:Name="figureUncompleted" StartPoint="100,100">
                                                        <LineSegment x:Name="lineUncompleted" Point="100,100"/>
                                                        <ArcSegment x:Name="arcUncompleted" 
                                                                    Size="100,100" 
                                                                    SweepDirection="Clockwise" 
                                                                    Point="100,100" 
                                                                    IsLargeArc="False"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        
                                    </Canvas>
                                </Viewbox>
                                
                                <!-- Labels Outside (Count | Percentage) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock x:Name="lblCompletedInfo" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#4CAF50" 
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Completed" 
                                                   FontSize="12" 
                                                   Foreground="Black" 
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="lblUncompletedInfo" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#F44336" 
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Uncompleted" 
                                                   FontSize="12" 
                                                   Foreground="Black" 
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Notes -->
                        <Border Padding="20" Margin="10,0,0,10" Grid.Column="2" CornerRadius="10" Background="#FFFACD"
>
                            <TextBox 
    x:Name="txtNotes"
    Text="Add your notes here..."
    TextWrapping="Wrap"
    FontSize="13"
    BorderThickness="0"
    Background="Transparent"
    AcceptsReturn="True"
    Foreground="Gray"
    GotFocus="txtNotes_GotFocus"
    LostFocus="txtNotes_LostFocus"/>

                        </Border>
                    </Grid>
                </TabItem>
                <!-- To-Do List Tab -->
                <TabItem Width="305" Margin="174,1,-174,-3" Header="To-Do List"
>
                    <Border Height="406" Padding="20" Background="#0F172A"
>
                        <Grid
>
                            <Grid.RowDefinitions
>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Add Task -->
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal"
>
                                <TextBox Width="300" Text="Enter task..." x:Name="txtNewTask" LostFocus="TxtNewTask_LostFocus" Height="30" GotFocus="TxtNewTask_GotFocus" Foreground="Gray"/>
                                <Button Width="80" Margin="10,0,0,0" Height="30" Content="Add" Click="AddTask_Click"/>
                            </StackPanel>
                            <!-- Task List -->
                            <DataGrid
                      Grid.Row="1"
                      Margin="0,0,453,0" x:Name="dgTodo" HeadersVisibility="Column" CanUserAddRows="False" Background="White" AutoGenerateColumns="False"
>
                                <DataGrid.Columns
>
                                    <!-- Task Name -->
                                    <DataGridTextColumn Binding="{Binding task_name}" Header="Task" Width="*"/>
                                    <!-- Status -->
                                    <DataGridCheckBoxColumn Binding="{Binding is_completed}" Header="Done?" Width="100"/>
                                    <!-- Remove Button -->
                                    <DataGridTemplateColumn Header="Remove" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" 
                                                        Width="70" 
                                                        Height="25" 
                                                        Click="RemoveTask_Click"
                                                        Background="#DC3545"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="11">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="5,2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#C82333"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Save Button -->
                            <Button Width="140" VerticalAlignment="Top" Grid.Row="2" RenderTransformOrigin="0.5,0.5" Margin="0,5,0,0" Height="35" HorizontalAlignment="Center" Content="Save Changes" Click="SaveTodoChanges_Click"
>
                                <Button.RenderTransform
>
                                    <TransformGroup
>
                                        <ScaleTransform/>
                                        <SkewTransform AngleX="3.094"/>
                                        <RotateTransform/>
                                        <TranslateTransform X="0.946"/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                            <StackPanel Grid.Row="1" Margin="457,0,0,0" Width="300">
                                <!-- Header for Completed Tasks -->
                                <Border Background="#1E293B" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                    <TextBlock Text="Done Tasks" Foreground="White" FontWeight="Bold"/>
                                </Border>

                                <ListView x:Name="lstCompletedTasks" MouseDoubleClick="RestoreTask_DoubleClick"
              Background="White" Height="320">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Task" DisplayMemberBinding="{Binding task_name}" Width="280"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>

                        </Grid>
                    </Border>
                </TabItem>
                <!-- Financials Tab -->
                <TabItem Width="305" Margin="174,1,-174,-3" Header="Financials"
>
                    <Grid Background="#1E2A38"
>
                        <Grid.ColumnDefinitions
>
                            <ColumnDefinition Width="37*"/>
                            <ColumnDefinition Width="63*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Financials Content Here" Margin="200,0,0,0" HorizontalAlignment="Left" Foreground="White" Grid.Column="2"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</Window>