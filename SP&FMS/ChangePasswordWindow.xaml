<Window x:Class="SP_FMS.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" ResizeMode="NoResize">

    <Grid Height="370" VerticalAlignment="Center">
        <Border Padding="30" Background="#1C2433" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Change Password" Foreground="White"
                           FontWeight="Bold" FontSize="20" TextAlignment="Center" Margin="0,0,0,20"/>

                <!-- Current Password -->
                <TextBlock Text="Current Password:" Foreground="White" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtCurrentPassword" Height="30" Width="300" Margin="0,0,0,15"/>

                <!-- New Password -->
                <TextBlock Text="New Password:" Foreground="White" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtNewPassword" Height="30" Width="300" Margin="0,0,0,15"/>

                <!-- Confirm New Password -->
                <TextBlock Text="Confirm New Password:" Foreground="White" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmPassword" Height="30" Width="300" Margin="0,0,0,25"/>

                <!-- Error Message -->
                <TextBlock x:Name="lblErrorMessage" 
                           Foreground="Red" 
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Cancel" Width="120" Height="35" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Change Password" Width="150" Height="35" Click="ChangePassword_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

