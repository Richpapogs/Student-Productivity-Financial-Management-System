<Window x:Class="SP_FMS.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Dashboard"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0E1726">

    <Grid Margin="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Student Dashboard"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="10,10,0,20" HorizontalAlignment="Center"/>
            <TabControl Background="#0E1726"
                        BorderThickness="0"
                        Padding="10"
                        FontSize="14"
                        Foreground="White" Height="430" Width="965">

                <!-- Profile Tab -->
                <TabItem Header="Profile" Margin="32,1,-174,-3">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="101*" />
                            <ColumnDefinition Width="129*" />
                        </Grid.ColumnDefinitions>

                        <!-- Personal Info -->
                        <Border Background="White"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,107,10">
                            <StackPanel>

                                <StackPanel/>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Grid.Column="1"
                                Background="#FFFACD"
                                CornerRadius="10"
                                Padding="20" Margin="198,0,0,0">
                            <TextBox Text="Add your notes here..."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- To-Do List Tab -->
                <TabItem Header="To-Do List" Margin="174,1,-174,-3" Width="305">
                    <Grid Background="#1E2A38">
                        <TextBlock Text="To-Do List Content Here"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </TabItem>

                <!-- Financials Tab -->
                <TabItem Header="Financials" Margin="174,1,-174,-3" Width="305">
                    <Grid Background="#1E2A38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="37*"/>
                            <ColumnDefinition Width="63*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Financials Content Here"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Grid.Column="2" Margin="200,0,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Tabs -->
        </StackPanel>
    </Grid>
</Window>