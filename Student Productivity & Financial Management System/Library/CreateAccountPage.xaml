<Window x:Class="Library.Pages.CreateAccountPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account" Height="590" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" ResizeMode="NoResize">

    <Grid Height="556" VerticalAlignment="Center">
        <Border Padding="30" Background="#1C2433" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Create Student Account" Foreground="White"
                           FontWeight="Bold" FontSize="18" TextAlignment="Center" Margin="0,0,0,10"/>

                <!-- Student ID -->
                <TextBlock Text="Student ID:" Foreground="White"/>
                <TextBox x:Name="txtID" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- First Name -->
                <TextBlock Text="First Name:" Foreground="White"/>
                <TextBox x:Name="txtFName" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- Last Name -->
                <TextBlock Text="Last Name:" Foreground="White"/>
                <TextBox x:Name="txtLName" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- Course/Section -->
                <TextBlock Text="Course/Section:" Foreground="White"/>
                <TextBox x:Name="txtCourse" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- Email -->
                <TextBlock Text="Email:" Foreground="White"/>
                <TextBox x:Name="txtEmail" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- Contact (new) -->
                <TextBlock Text="Contact:" Foreground="White"/>
                <TextBox x:Name="txtContact" Height="24" Width="200" Margin="0,5,0,10"/>

                <!-- Password -->
                <TextBlock Text="Password:" Foreground="White"/>
                <PasswordBox x:Name="txtPassword" Height="24" Width="200" Margin="0,5,0,20"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Back" Width="100" Height="30" Click="Back_Click"/>
                    <Button Content="Create" Width="100" Height="30" Click="CreateAccount_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
