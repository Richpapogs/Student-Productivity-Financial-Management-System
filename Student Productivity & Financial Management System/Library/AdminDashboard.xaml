<Window x:Class="Library.Pages.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Admin Dashboard"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Library Admin Dashboard"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>
            
        </DockPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" Background="#1C2433" CornerRadius="8" Padding="10">
            <StackPanel>
                <TextBlock Text="Borrowed Records" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                <DataGrid x:Name="dgBorrowRecords"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          Background="#1C2433"
          Foreground="Black"
          BorderBrush="Gray"
          Margin="20"
          FontSize="13">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Student ID" Binding="{Binding student_id}" Width="*"/>
                        <DataGridTextColumn Header="Book ID" Binding="{Binding book_id}" Width="*"/>
                        <DataGridTextColumn Header="Board Game ID" Binding="{Binding boardgame_id}" Width="*"/>
                        <DataGridTextColumn Header="Date Borrowed" Binding="{Binding date_borrowed}" Width="*"/>
                        <DataGridTextColumn Header="Time Borrowed" Binding="{Binding time_borrowed}" Width="*"/>
                        <DataGridTextColumn Header="Time Returned" Binding="{Binding time_returned}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="*"/>

                        <!-- Action button -->
                        <DataGridTemplateColumn Header="Action" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Logout"
                            Background="#FFD40000"
                            Foreground="White"
                            Padding="5,2"
                            Margin="2"
                            Click="LogoutBorrow_Click"
                            Tag="{Binding record_id}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>


            </StackPanel>
        </Border>
    </Grid>
</Window>
